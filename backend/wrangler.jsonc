{
  "name": "demystifying-the-ai-blackbox-api",
  "main": "worker.mjs",
  "compatibility_date": "2025-05-15",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "WORKSHOP_ORIGIN": "https://niclaguerta.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blackbox-workshop-responses",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
